# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inception

# Secret for signing access-token JWTs (use a long random string)
JWT_SECRET=change-me-to-a-long-random-string

# Shared secret for the internal youtube-live-check endpoint / cron
INTERNAL_TOKEN=change-me-too

# YouTube Data API v3 key (used by youtube-import / youtube-live-check)
YOUTUBE_API_KEY=

# Directory where uploaded files are stored (mounted as a Docker volume in prod)
UPLOAD_DIR=./uploads

# HTTP port
PORT=8080

# Comma-separated list of allowed CORS origins for local dev (optional)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Set to "true" to run the youtube-live-check cron inside this process
ENABLE_CRON=false
