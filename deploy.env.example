# Copy to deploy.env and fill in. Used by docker-compose (--env-file deploy.env).
# On EasyPanel, set these as environment variables on the `api` / `postgres` services.

# --- Postgres ---
POSTGRES_USER=inception
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=inception

# --- API ---
# Long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=
# Shared secret for the internal youtube-live-check endpoint / cron
INTERNAL_TOKEN=
# YouTube Data API v3 key (same one used by the old edge functions)
YOUTUBE_API_KEY=
# Run the youtube-live-check cron inside the api container
ENABLE_CRON=true
